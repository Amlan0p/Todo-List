# Copy this file to ".env" for local development. NEVER commit ".env".
# On Render, set these in the service's "Environment" tab instead.

# PostgreSQL connection string.
# Local example:  postgresql://postgres:yourpassword@localhost:5432/todos
# On Render use the "Internal Database URL" (backend and database in the same region).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Optional: force SSL on/off. Leave unset for automatic behaviour
# (SSL for remote hosts such as Render's External URL, off for localhost / Internal URL).
# DATABASE_SSL=true

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login token lasts (e.g. 15m, 12h, 7d). Default if unset: 7d
JWT_EXPIRES_IN=7d

# Render sets PORT automatically. Only needed locally.
PORT=5000

# The exact URL of your deployed frontend (no trailing slash). Several can be comma-separated.
# Not needed for local development (localhost is allowed when NODE_ENV is not "production").
FRONTEND_URL=https://your-frontend.onrender.com

# Set to "production" on Render.
NODE_ENV=development
